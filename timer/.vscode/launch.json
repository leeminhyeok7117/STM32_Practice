{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "timer",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/timer.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "device": "STM32F446RE",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "gdbPath": "/usr/bin/gdb-multiarch",
            
            "runToEntryPoint": "main",
            "showDevDebugOutput": "none"
        }
    ]
}